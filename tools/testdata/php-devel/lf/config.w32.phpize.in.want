// configure script header
if (PHP_PREFIX == '' || PHP_PREFIX == "C:\\php") {
	// Polka auto-patch: dynamically resolve PHP_PREFIX to the matching Polka PHP runtime
	try {
		var envShell = WshShell;
		var envPrefix = envShell.Environment("Process").Item("PHP_PREFIX");
		if (envPrefix && FSO.FileExists(FSO.BuildPath(envPrefix, "php.exe"))) {
			PHP_PREFIX = envPrefix;
		} else {
			var polkaEnvsDir = FSO.GetParentFolderName(FSO.GetParentFolderName(PHP_DIR));
			var polkaFlavor = (typeof(PHP_ZTS) == "string" && PHP_ZTS.toLowerCase() == "yes") ? "php-zts" : "php";
			var polkaCandidate = FSO.BuildPath(FSO.BuildPath(polkaEnvsDir, polkaFlavor), PHP_VERSION + "." + PHP_MINOR_VERSION);
			if (FSO.FileExists(FSO.BuildPath(polkaCandidate, "php.exe"))) {
				PHP_PREFIX = polkaCandidate;
			}
		}
	} catch (e) {}
	if (PHP_PREFIX == '') {
		PHP_PREFIX = "C:\\php";
	}
	if (PHP_DEBUG == "yes")
		PHP_PREFIX += "\\debug";
}
DEFINE('PHP_PREFIX', PHP_PREFIX);
DEFINE("BASE_INCLUDES", "/I " + PHP_DIR + "/include");
