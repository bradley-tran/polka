# Generates phpMyAdmin's config.inc.php. The blowfish secret is regenerated on
# every install. Managed MySQL and MariaDB databases also get configuration
# storage and automatic login through the credentials file Polka writes before
# starting phpMyAdmin.

_CONFIG_FILE = "config.inc.php"
_TEMP_DIRECTORY = "tmp"
_DATABASE_HOST = "127.0.0.1"
_DEFAULT_DATABASE_PORT = 3306
_STORAGE_DATABASE = "phpmyadmin"
_MANAGED_DATABASE_USER = "polka"
_MANAGED_ENGINES = ["mysql", "mariadb"]

_STORAGE_TABLES = [
    ("bookmarktable", "pma__bookmark"),
    ("relation", "pma__relation"),
    ("table_info", "pma__table_info"),
    ("table_coords", "pma__table_coords"),
    ("pdf_pages", "pma__pdf_pages"),
    ("column_info", "pma__column_info"),
    ("history", "pma__history"),
    ("table_uiprefs", "pma__table_uiprefs"),
    ("tracking", "pma__tracking"),
    ("userconfig", "pma__userconfig"),
    ("recent", "pma__recent"),
    ("favorite", "pma__favorite"),
    ("users", "pma__users"),
    ("usergroups", "pma__usergroups"),
    ("navigationhiding", "pma__navigationhiding"),
    ("savedsearches", "pma__savedsearches"),
    ("central_columns", "pma__central_columns"),
    ("designer_settings", "pma__designer_settings"),
    ("export_templates", "pma__export_templates"),
]

def _php_string(value):
    """Quotes value as a single-quoted PHP string."""
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"

def _server(key, value):
    """Renders one setting of the configured server."""
    return "$cfg['Servers'][$i]['%s'] = %s;" % (key, value)

def _render(secret, database, credentials_path):
    """Renders config.inc.php."""
    managed = database != None and database.engine in _MANAGED_ENGINES
    port = _DEFAULT_DATABASE_PORT
    if managed and database.port != 0:
        port = database.port
    port_literal = _php_string(str(port))
    managed_login = managed and credentials_path != ""

    lines = [
        "<?php",
        "declare(strict_types=1);",
        "",
        "/**",
        " * Generated by Polka. Re-run polka install after editing phpMyAdmin or database settings.",
        " */",
        "$cfg['blowfish_secret'] = %s;" % _php_string(secret),
        "",
        "$i = 0;",
        "$i++;",
    ]
    if managed_login:
        lines += [
            "$polkaCredentials = [];",
            "$polkaCredentialsPath = %s;" % _php_string(credentials_path),
            "if (is_readable($polkaCredentialsPath)) {",
            "    $polkaCredentialsData = json_decode((string) file_get_contents($polkaCredentialsPath), true);",
            "    if (is_array($polkaCredentialsData)) {",
            "        $polkaCredentials = $polkaCredentialsData;",
            "    }",
            "}",
            "",
            _server("auth_type", "'config'"),
            _server("user", "(string) ($polkaCredentials['user'] ?? %s)" % _php_string(_MANAGED_DATABASE_USER)),
            _server("password", "(string) ($polkaCredentials['password'] ?? '')"),
        ]
    else:
        lines.append(_server("auth_type", "'cookie'"))

    lines.append(_server("host", _php_string(_DATABASE_HOST)))
    if managed_login:
        lines.append(_server("port", "(string) ($polkaCredentials['port'] ?? %s)" % port_literal))
    else:
        lines.append(_server("port", port_literal))
    lines += [
        _server("compress", "false"),
        _server("AllowNoPassword", "false"),
    ]
    if managed:
        lines.append(_server("pmadb", _php_string(_STORAGE_DATABASE)))
        for key, table in _STORAGE_TABLES:
            lines.append(_server(key, _php_string(table)))
        lines.append("")
    lines += [
        "$cfg['TempDir'] = __DIR__ . '/%s';" % _TEMP_DIRECTORY,
        "$cfg['UploadDir'] = '';",
        "$cfg['SaveDir'] = '';",
        "",
    ]
    return "\n".join(lines)

def post_install(ctx):
    credentials_path = ""
    if ctx.database != None and ctx.database.engine in _MANAGED_ENGINES and ctx.environment != "":
        credentials_path = path.join(ctx.root_dir, "secrets", "db", ctx.environment + ".json")

    return {
        "mkdir": [_TEMP_DIRECTORY],
        "write": {_CONFIG_FILE: _render(crypto.random_base64(24), ctx.database, credentials_path)},
    }
