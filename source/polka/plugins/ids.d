module polka.plugins.ids;

import std.algorithm : canFind;
import std.format : format;
import std.path : isRooted;
import std.regex : matchFirst, regex;
import std.string : split, strip, stripRight, toLower;

import polka.config;
import polka.tools.ids;

/// Built-in plugin type names matching Go `plugins` constants.
enum string TypeTool = "tool";
enum string TypeFramework = "framework";
enum string TypePreset = "preset";

/// Built-in framework identifiers.
enum string CakePHP = "cakephp";
enum string CodeIgniter = "codeigniter";
enum string Drupal = "drupal";
enum string WordPress = "wordpress";
enum string Laravel = "laravel";
enum string Symfony = "symfony";

/// Built-in project preset identifier.
enum string PHPExtension = "php-extension";

package(polka.plugins):
enum int defaultDatabasePort = 3306;
enum int defaultPostgreSQLPort = 5432;
enum string defaultDatabaseHost = "127.0.0.1";

public:

/// Checks whether `id` uses the allowed plugin/marker identifier grammar.
bool isValidPluginID(string id) @safe
{
    auto re = regex(`^[A-Za-z0-9][A-Za-z0-9._-]*$`);
    return !id.matchFirst(re).empty;
}

/// Framework-safe shape of generated database credentials passed to plugins.
struct DatabaseCredentials
{
    string engine;
    string version_;
    string host;
    int port = 0;
    string databaseName;
    string user;
    string password;
}

/// Context passed to framework plugins while composing process environment variables.
struct RuntimeEnvContext
{
    Environment environment;
    DatabaseCredentials* database;
}

/// Context passed to framework plugins after selected Composer workflows finish.
struct PostComposerContext
{
    Environment environment;
    string projectDir;
    string workingDir;
    string[] args;
    DatabaseCredentials* database;
}

/// Context passed to framework plugins before Polka writes its generated nginx config.
struct NginxConfigContext
{
    Environment environment;
    string host;
    int port = 0;
    string docroot;
    string indexNames;
    string tryFilesFallback;
    string fastCGIIndex;
    string backendAddress;
    bool tlsEnabled = false;
    string tlsCertificatePath;
    string tlsCertificateKeyPath;
}

/// Optional replacement generated by a framework plugin's `nginxConfig` hook.
struct NginxConfigResult
{
    ubyte[] config;
}

/// Package-name and file signals used to detect a framework.
/// Prefix matches precede substring matches, which precede marker files.
struct FrameworkDetection
{
    string[] packagePrefixes;
    string[] packageSubstrings;
    string[] markers;
    int priority = 0;

    /// Returns an isolated deep copy so callers cannot mutate registry metadata.
    FrameworkDetection clone() const @safe pure
    {
        return FrameworkDetection(
            packagePrefixes.dup,
            packageSubstrings.dup,
            markers.dup,
            priority,
        );
    }

    /// Validates detection signals are nonempty, distinctive, and stay within base.
    void validate() const @safe
    {
        foreach (pattern; packagePrefixes)
        {
            if (pattern.strip().length == 0)
                throw new Exception("detection package patterns cannot be empty");
        }
        foreach (pattern; packageSubstrings)
        {
            if (pattern.strip().length == 0)
                throw new Exception("detection package patterns cannot be empty");
        }
        foreach (marker; markers)
        {
            if (marker == "composer.json")
                throw new Exception("detection marker composer.json is not distinctive");
            validateFrameworkManifestRelativePath(marker, "detection.markers", false);
        }
    }
}

/// Permissive application-root hints consulted independently of distinctive detection signals.
struct FrameworkAppRootConfig
{
    string publicDir;
    string[] markers;

    FrameworkAppRootConfig clone() const @safe pure
    {
        return FrameworkAppRootConfig(publicDir, markers.dup);
    }
}

/// Higher-level PHP framework integration plugin interface.
interface FrameworkPlugin
{
    string id() const;
    Environment defaults() const;
    bool[string] phpExtensions() const;
    void validateEnvironment(const Environment environment) const;
    string[string] opcacheConfig() const;
    FrameworkDetection detection() const;
    string[string] runtimeEnv(const RuntimeEnvContext ctx) const;
    void postComposer(const PostComposerContext ctx) const;
    bool nginxConfig(const NginxConfigContext ctx, out NginxConfigResult result) const;
}

/// One project-relative file rendered by a project preset during `init`.
struct ScaffoldFile
{
    string path;
    ubyte[] content;
}

/// Values interpolated by project preset templates during `init`.
struct ScaffoldContext
{
    string projectDir;
    string packageName;
    string phpVersion;
}

/// Starting environment config for a non-framework project shape (`init` defaults & files).
interface ProjectPreset
{
    string id() const;
    string description() const;
    Environment defaults() const;
    ScaffoldFile[] scaffoldFiles(const ScaffoldContext ctx) const;
}

/// Abstract asset filesystem replacing Go's `fs.FS` for embedded or in-memory manifests/templates.
interface FrameworkAssetSource
{
    string[] listManifests() const @safe;
    bool hasFile(string path) const @safe;
    string readFile(string path) const @safe;
}

/// In-memory asset source mirroring Go's `fstest.MapFS` for deterministic tests.
final class MemoryFrameworkAssetSource : FrameworkAssetSource
{
    private string[string] files;

    this(string[string] initialFiles = null) @safe pure
    {
        foreach (k, v; initialFiles)
            files[k] = v;
    }

    void set(string path, string content) @safe pure
    {
        files[path] = content;
    }

    string[] listManifests() const @safe
    {
        import std.algorithm : sort, startsWith, endsWith;
        string[] result;
        foreach (path; files.keys)
        {
            if (path.startsWith("manifests/") && path.endsWith(".yaml"))
            {
                auto rest = path["manifests/".length .. $];
                if (!rest.canFind('/'))
                    result ~= path;
            }
        }
        result.sort();
        return result;
    }

    bool hasFile(string path) const @safe
    {
        return (path in files) !is null;
    }

    string readFile(string path) const @safe
    {
        auto p = path in files;
        if (p is null)
            throw new Exception(format("file %s does not exist", path));
        return *p;
    }
}

/// Checks Go `io/fs.ValidPath` semantics (forward-slash separated, no empty, `.`, or `..` segments).
bool isValidFSPath(string name) @safe pure
{
    if (name.length == 0 || name[0] == '/' || name[$ - 1] == '/')
        return false;
    if (name == ".")
        return true;
    foreach (seg; name.split('/'))
    {
        if (seg.length == 0 || seg == "." || seg == "..")
            return false;
    }
    return true;
}

/// Applies portable containment rules for framework manifest relative paths,
/// rejecting Windows drive letters, backslashes, NULs, and trailing dots/spaces.
void validateFrameworkManifestRelativePath(string value, string label, bool allowDot) @safe pure
{
    if (value == "." && allowDot)
        return;
    if (value.length == 0 || value.canFind('\\') || value.canFind(':') || value.canFind('\0') || !isValidFSPath(value))
        throw new Exception(format("%s %s must be a slash-separated relative path inside its base", label, formatGoQuoted(value)));
    foreach (segment; value.split('/'))
    {
        if (segment.stripRight(" .") != segment)
            throw new Exception(format("%s %s must not contain trailing dots or spaces in path segments", label, formatGoQuoted(value)));
    }
}

/// Validates a project preset scaffold destination path (relative, slash-separated, not reserved).
void validateProjectPresetScaffoldPath(string target) @safe pure
{
    auto trimmed = target.strip();
    if (trimmed.length == 0)
        throw new Exception("scaffold path cannot be empty");
    if (trimmed.canFind('\\') || trimmed[0] == '/' || isRooted(trimmed)
        || (trimmed.length >= 2 && trimmed[1] == ':'))
    {
        throw new Exception(format("scaffold path %s must be slash-separated and relative", formatGoQuoted(target)));
    }
    foreach (segment; trimmed.split('/'))
    {
        if (segment.length == 0 || segment == "." || segment == "..")
            throw new Exception(format("scaffold path %s must not contain empty, . or .. segments", formatGoQuoted(target)));
    }
    auto lower = trimmed.toLower();
    import std.algorithm : startsWith, endsWith;
    if (lower == "polka.yaml"
        || (lower.startsWith("polka.") && lower.endsWith(".yaml"))
        || lower == ".polka"
        || lower.startsWith(".polka/"))
    {
        throw new Exception(format("scaffold path %s is reserved for init", formatGoQuoted(target)));
    }
}

/// Normalizes default database port for a database engine.
int frameworkDefaultDatabasePort(string engine) @safe pure
{
    if (engine.strip().toLower() == PostgreSQL)
        return defaultPostgreSQLPort;
    return defaultDatabasePort;
}

/// Normalizes database credentials without mutating caller data.
DatabaseCredentials* normalizeDatabaseCredentials(const DatabaseCredentials credentials) @safe pure
{
    auto normalized = new DatabaseCredentials();
    normalized.engine = credentials.engine.strip().toLower();
    normalized.version_ = credentials.version_.strip();
    normalized.host = credentials.host.strip();
    normalized.port = credentials.port;
    normalized.databaseName = credentials.databaseName.strip();
    normalized.user = credentials.user.strip();
    normalized.password = credentials.password;

    if (normalized.host.length == 0)
        normalized.host = defaultDatabaseHost;
    if (normalized.port == 0)
        normalized.port = frameworkDefaultDatabasePort(normalized.engine);
    return normalized;
}

/// Pointer convenience overload for `normalizeDatabaseCredentials`.
DatabaseCredentials* normalizeDatabaseCredentials(const(DatabaseCredentials)* credentials) @safe pure
{
    if (credentials is null)
        return null;
    return normalizeDatabaseCredentials(*credentials);
}

/// Builds a normalized extension enablement map from extension names.
bool[string] phpExtensionMap(const(string)[] names...) @safe pure
{
    bool[string] extensions;
    foreach (name; names)
    {
        auto normalized = name.strip().toLower();
        if (normalized.length > 0)
            extensions[normalized] = true;
    }
    return extensions;
}

/// Copies a `bool[string]` map returning `null` if empty.
bool[string] copyBoolMap(const(bool[string]) values) @safe pure
{
    if (values.length == 0)
        return null;
    bool[string] copied;
    foreach (k, v; values)
        copied[k] = v;
    return copied;
}

/// Copies a `string[string]` map returning `null` if empty.
string[string] copyStringMap(const(string[string]) values) @safe pure
{
    if (values.length == 0)
        return null;
    string[string] copied;
    foreach (k, v; values)
        copied[k] = v;
    return copied;
}

package(polka.plugins) string formatGoQuoted(string s) @safe pure
{
    import std.array : appender;
    auto buf = appender!string();
    buf.put('"');
    foreach (char c; s)
    {
        switch (c)
        {
            case '\\': buf.put(`\\`); break;
            case '"':  buf.put(`\"`); break;
            case '\n': buf.put(`\n`); break;
            case '\r': buf.put(`\r`); break;
            case '\t': buf.put(`\t`); break;
            case '\0': buf.put(`\x00`); break;
            default:   buf.put(c); break;
        }
    }
    buf.put('"');
    return buf.data;
}

unittest
{
    assert(isValidPluginID("laravel"));
    assert(isValidPluginID("php-extension"));
    assert(!isValidPluginID("not a framework"));
    assert(!isValidPluginID(""));

    validateFrameworkManifestRelativePath(".", "app-root.public-dir", true);
    validateFrameworkManifestRelativePath("sites/default/settings.php", "path", false);

    bool threw = false;
    try { validateFrameworkManifestRelativePath("../file", "path", false); } catch (Exception) { threw = true; }
    assert(threw);

    threw = false;
    try { validateFrameworkManifestRelativePath("C:/file", "path", false); } catch (Exception) { threw = true; }
    assert(threw);

    threw = false;
    try { validateFrameworkManifestRelativePath(".. /file", "path", false); } catch (Exception) { threw = true; }
    assert(threw);

    assert(frameworkDefaultDatabasePort("postgresql") == 5432);
    assert(frameworkDefaultDatabasePort("mysql") == 3306);
}
