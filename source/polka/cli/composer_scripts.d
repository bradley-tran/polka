unittest
{
    import std.file : mkdirRecurse;
    import polka.support.fs : createTempDir, rmdirRecurseQuiet;

    // Windows branch tests (executed cross-platform on Linux as well!):
    // Creates .cmd wrapper, verifies marker & command line, and removes on cleanup.
    auto projectDir = createTempDir("polka-win-cs-");
    scope (exit) rmdirRecurseQuiet(projectDir);

    auto binDir = buildPath(projectDir, "bin");
    mkdirRecurse(binDir);
    auto consolePath = buildPath(binDir, "console");
    write(consolePath, "#!/usr/bin/env php\n<?php echo 'ok';\n");
    write(buildPath(projectDir, "composer.json"), `{
  "scripts": {
    "post-install-cmd": ["@post-cmd"],
    "post-cmd": ["Vendor\\Handler::run", "bin/console cache:clear --no-warmup"]
  }
}`);

    auto support = prepareWindowsComposerScriptSupport("windows", projectDir, null, null);
    auto wrapperPath = consolePath ~ ".cmd";
    assert(exists(wrapperPath));
    auto text = readText(wrapperPath);
    assert(text.canFind(windowsComposerPHPWrapperMarker));
    assert(text.canFind(`call php "` ~ consolePath ~ `" %*`));

    assert(support.cleanup() is null);
    assert(!exists(wrapperPath));
}

unittest
{
    import polka.support.fs : createTempDir, rmdirRecurseQuiet;

    // Windows branch preserves project-owned .bat wrapper.
    auto projectDir = createTempDir("polka-win-keep-");
    scope (exit) rmdirRecurseQuiet(projectDir);

    auto consolePath = buildPath(projectDir, "console");
    write(consolePath, "#!/usr/bin/env php\n<?php\n");
    auto existingWrapper = "@echo project wrapper\r\n";
    auto batPath = consolePath ~ ".bat";
    write(batPath, existingWrapper);
    write(buildPath(projectDir, "composer.json"), `{"scripts":{"test":"console test"}}`);

    auto support = prepareWindowsComposerScriptSupport("windows", projectDir, null, null);
    assert(support.cleanup() is null);
    assert(readText(batPath) == existingWrapper);
    assert(!exists(consolePath ~ ".cmd"));
}

