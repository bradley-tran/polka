module polka.cli.composer_scripts;

// Cross-platform Composer script execution support:
// - On Linux: temporarily grants the executable bit to direct extensionless
//   PHP-shebang scripts declared in composer.json when missing, restoring original modes afterward.
// - On Windows: writes temporary PATHEXT-compatible `.cmd` companions for direct
//   extensionless PHP-shebang scripts without overwriting project-owned wrappers.

import std.algorithm : canFind, sort, startsWith;
import std.array : appender;
import std.file : exists, readText, remove, write;
import std.format : format;
import std.json : JSONType, parseJSON;
import std.path : buildPath, extension, isAbsolute, relativePath;
import std.string : icmp, toLower;

import polka.backend : TextWriter, tryCreateExclusiveFile;
import polka.cli.types :
    escapeWindowsShimValue,
    executeTargetWithEnv,
    isMissingFileError,
    isPHPShebang,
    lookupEnvValue,
    readScriptFirstLine;
import polka.support.fs :
    cleanPath,
    fromSlashPath,
    getFileMode,
    octal,
    setFileMode,
    toSlashPath;

/// Marker comment identifying temporary `.cmd` wrappers generated by Polka on Windows.
enum string windowsComposerPHPWrapperMarker = "rem Generated temporarily by Polka for a Composer PHP script.";

/// Records a script target whose file permissions were temporarily augmented on Linux.
struct LinuxComposerScriptModeRestore
{
    string path;
    uint originalMode = 0;
}

/// Tracks temporary executable-permission grants made for direct PHP-shebang
/// Composer scripts on Linux so original modes can be restored after execution.
struct LinuxComposerScriptSupport
{
    LinuxComposerScriptModeRestore[] restored;

    /// Adds executable permission bits (`0o111`) if absent and records original mode.
    void grantExecutePermission(string target) @trusted
    {
        if (!exists(target))
            throw new Exception(format(`stat Composer script target "%s": no such file or directory`, target));

        uint mode = getFileMode(target);
        if ((mode & octal!111) != 0)
            return;

        try
        {
            setFileMode(target, mode | octal!111);
        }
        catch (Exception e)
        {
            throw new Exception(format(`grant execute permission to Composer script target "%s": %s`, target, e.msg));
        }

        restored ~= LinuxComposerScriptModeRestore(target, mode);
    }

    /// Restores original modes on every modified target (ignoring files deleted during execution).
    Exception cleanup() @trusted
    {
        string[] errs;
        foreach (restore; restored)
        {
            if (!exists(restore.path))
                continue;
            try
            {
                setFileMode(restore.path, restore.originalMode);
            }
            catch (Exception e)
            {
                if (!isMissingFileError(e))
                    errs ~= format(`restore permissions for temporary Composer script target "%s": %s`, restore.path, e.msg);
            }
        }
        if (errs.length > 0)
        {
            import std.string : join;
            return new Exception(errs.join("; "));
        }
        return null;
    }
}

/// Tracks temporary `.cmd` companion wrappers created on Windows for Composer scripts.
struct WindowsComposerScriptSupport
{
    string[] created;

    /// Creates a PATHEXT-compatible `.cmd` wrapper unless a `.bat`/`.cmd` already exists
    /// (adopting existing Polka-marked wrappers for cleanup).
    string createWrapper(string target) @trusted
    {
        foreach (existing; [target ~ ".bat", target ~ ".cmd"])
        {
            string data;
            bool readOK = false;
            try
            {
                data = readText(existing);
                readOK = true;
            }
            catch (Exception e)
            {
                if (!isMissingFileError(e))
                    throw new Exception(format(`inspect Composer script wrapper "%s": %s`, existing, e.msg));
            }
            if (readOK)
            {
                if (data.canFind(windowsComposerPHPWrapperMarker))
                    return existing;
                return "";
            }
        }

        auto wrapperPath = target ~ ".cmd";
        auto contents = "@echo off\r\n" ~
            windowsComposerPHPWrapperMarker ~ "\r\n" ~
            `call php "` ~ escapeWindowsShimValue(target) ~ `" %*` ~ "\r\n" ~
            "exit /b %ERRORLEVEL%\r\n";

        try
        {
            if (!tryCreateExclusiveFile(wrapperPath, cast(const(ubyte)[]) contents, octal!755))
                return "";
        }
        catch (Exception e)
        {
            throw new Exception(format(`write Composer PHP script wrapper "%s": %s`, wrapperPath, e.msg));
        }

        return wrapperPath;
    }

    /// Removes only temporary `.cmd` wrappers carrying Polka's marker comment.
    Exception cleanup() @trusted
    {
        string[] errs;
        foreach (wrapperPath; created)
        {
            string data;
            try
            {
                data = readText(wrapperPath);
            }
            catch (Exception e)
            {
                if (!isMissingFileError(e))
                    errs ~= format(`inspect temporary Composer wrapper "%s": %s`, wrapperPath, e.msg);
                continue;
            }
            if (!data.canFind(windowsComposerPHPWrapperMarker))
                continue;
            try
            {
                remove(wrapperPath);
            }
            catch (Exception e)
            {
                if (!isMissingFileError(e))
                    errs ~= format(`remove temporary Composer wrapper "%s": %s`, wrapperPath, e.msg);
            }
        }
        if (errs.length > 0)
        {
            import std.string : join;
            return new Exception(errs.join("; "));
        }
        return null;
    }
}

/// Applies Composer`-d`/`--working-dir` flags to determine the effective project directory.
string composerCommandWorkingDir(string workingDir, const(string)[] args) @trusted
{
    import std.string : strip;
    auto resolved = workingDir;
    for (size_t index = 0; index < args.length; index++)
    {
        auto arg = args[index].strip();
        if (arg == "--")
            break;

        string value;
        if (arg == "-d" || arg == "--working-dir")
        {
            if (index + 1 < args.length)
            {
                value = args[index + 1];
                index++;
            }
        }
        else if (arg.startsWith("--working-dir="))
        {
            value = arg["--working-dir=".length .. $];
        }
        else if (arg.startsWith("-d") && arg.length > 2)
        {
            value = arg[2 .. $];
        }

        if (value.strip().length == 0)
            continue;
        auto nativeVal = fromSlashPath(value);
        if (isAbsolute(nativeVal))
            resolved = nativeVal;
        else
            resolved = buildPath(workingDir, nativeVal);
    }

    return cleanPath(resolved);
}

/// Resolves the Composer manifest path (`COMPOSER` env var override or `composer.json`).
string composerManifestPath(string goos, string workingDir, const(string)[] env) @trusted
{
    import std.string : strip;
    string key, val;
    bool ok = lookupEnvValue(goos, env, "COMPOSER", key, val);
    val = val.strip();
    if (!ok || val.length == 0 || val == "-")
        return buildPath(workingDir, "composer.json");

    auto nativeVal = fromSlashPath(val);
    if (isAbsolute(nativeVal))
        return cleanPath(nativeVal);
    return cleanPath(buildPath(workingDir, nativeVal));
}

/// Extracts scalar and array-valued script command strings from `composer.json` bytes,
/// sorted by script name.
string[] composerManifestScriptCommands(const(ubyte)[] data) @trusted
{
    return composerManifestScriptCommandsText((cast(const(char)[]) data).idup);
}

/// Text overload extracting script command strings from a `composer.json` payload.
string[] composerManifestScriptCommandsText(string jsonText) @trusted
{
    auto root = parseJSON(jsonText);
    if (root.type != JSONType.object)
        return null;
    auto scriptsNode = "scripts" in root;
    if (scriptsNode is null || scriptsNode.type != JSONType.object)
        return null;

    auto names = scriptsNode.object.keys;
    names.sort();

    string[] commands;
    foreach (name; names)
    {
        auto entry = (*scriptsNode)[name];
        if (entry.type == JSONType.string)
        {
            commands ~= entry.str;
        }
        else if (entry.type == JSONType.array)
        {
            foreach (item; entry.array)
            {
                if (item.type == JSONType.string)
                    commands ~= item.str;
            }
        }
    }
    return commands;
}

/// Returns the first command word when it resolves inside `workingDir` to an
/// extensionless PHP-shebang file.
bool composerDirectPHPScriptTarget(string workingDir, string command, out string targetPath) @trusted
{
    targetPath = "";
    auto word = firstComposerScriptWord(command);
    if (word.length == 0 || word.startsWith("@") || extension(word).length != 0)
        return false;

    auto nativeWord = fromSlashPath(word);
    string target = isAbsolute(nativeWord) ? nativeWord : buildPath(workingDir, nativeWord);
    target = cleanPath(target);

    auto cleanWork = cleanPath(workingDir);
    auto rel = relativePath(target, cleanWork);
    auto slashRel = toSlashPath(rel);
    if (rel == ".." || slashRel.startsWith("../"))
        return false;

    try
    {
        auto line = readScriptFirstLine(target);
        if (!isPHPShebang(line))
            return false;
        targetPath = target;
        return true;
    }
    catch (Exception)
    {
        return false;
    }
}

/// Parses one shell-style word from a Composer script string without expanding variables.
string firstComposerScriptWord(string command) @safe pure
{
    import std.string : strip;
    auto trimmed = command.strip();
    if (trimmed.length == 0)
        return "";

    auto buf = appender!string();
    dchar quote = 0;
    foreach (dchar current; trimmed)
    {
        if (quote != 0)
        {
            if (current == quote)
                quote = 0;
            else
                buf.put(current);
        }
        else if (current == '\'' || current == '"')
        {
            quote = current;
        }
        else if (current == ' ' || current == '\t' || current == '\r' || current == '\n')
        {
            return buf.data;
        }
        else
        {
            buf.put(current);
        }
    }
    return buf.data;
}

/// Scans the active `composer.json` and temporarily adds executable bits on Linux
/// for direct extensionless PHP-shebang script commands.
LinuxComposerScriptSupport prepareLinuxComposerScriptSupport(
    string goos,
    string workingDir,
    const(string)[] args,
    const(string)[] env
) @trusted
{
    LinuxComposerScriptSupport support;
    if (goos != "linux")
        return support;

    auto targets = collectComposerDirectPHPScriptTargets(goos, workingDir, args, env, false);
    foreach (target; targets)
    {
        try
        {
            support.grantExecutePermission(target);
        }
        catch (Exception grantErr)
        {
            auto cleanupErr = support.cleanup();
            if (cleanupErr !is null)
                throw new Exception(grantErr.msg ~ "; " ~ cleanupErr.msg);
            throw grantErr;
        }
    }
    return support;
}

/// Scans the active `composer.json` and writes temporary `.cmd` wrappers on Windows
/// for direct extensionless PHP-shebang script commands.
WindowsComposerScriptSupport prepareWindowsComposerScriptSupport(
    string goos,
    string workingDir,
    const(string)[] args,
    const(string)[] env
) @trusted
{
    WindowsComposerScriptSupport support;
    if (goos != "windows")
        return support;

    auto targets = collectComposerDirectPHPScriptTargets(goos, workingDir, args, env, true);
    foreach (target; targets)
    {
        string createdWrapper;
        try
        {
            createdWrapper = support.createWrapper(target);
        }
        catch (Exception createErr)
        {
            auto cleanupErr = support.cleanup();
            if (cleanupErr !is null)
                throw new Exception(createErr.msg ~ "; " ~ cleanupErr.msg);
            throw createErr;
        }
        if (createdWrapper.length > 0)
            support.created ~= createdWrapper;
    }
    return support;
}

private string[] collectComposerDirectPHPScriptTargets(
    string goos,
    string workingDir,
    const(string)[] args,
    const(string)[] env,
    bool caseInsensitiveKeys
) @trusted
{
    auto composerDir = composerCommandWorkingDir(workingDir, args);
    auto manifestPath = composerManifestPath(goos, composerDir, env);

    string text;
    try
    {
        text = readText(manifestPath);
    }
    catch (Exception e)
    {
        if (isMissingFileError(e))
            return null;
        throw new Exception(format(`read Composer manifest "%s": %s`, manifestPath, e.msg));
    }

    string[] commands;
    try
    {
        commands = composerManifestScriptCommandsText(text);
    }
    catch (Exception)
    {
        // Composer owns validation of its manifest; defer malformed JSON so Composer
        // emits its own diagnostic and exit status.
        return null;
    }

    bool[string] seen;
    string[] targets;
    foreach (command; commands)
    {
        string target;
        if (!composerDirectPHPScriptTarget(composerDir, command, target))
            continue;
        auto cleaned = cleanPath(target);
        auto key = caseInsensitiveKeys ? cleaned.toLower() : cleaned;
        if ((key in seen) !is null)
            continue;
        seen[key] = true;
        targets ~= target;
    }
    return targets;
}

/// Runs `target` with Composer script support enabled for `goos` when `isComposer` is true,
/// guaranteeing cleanup of temporary permissions/wrappers even when execution fails.
int executeTargetWithComposerScriptSupport(
    string goos,
    bool isComposer,
    TextWriter stdout,
    TextWriter stderr,
    const(string)[] env,
    string workingDir,
    string target,
    const(string)[] args
) @trusted
{
    if (!isComposer)
        return executeTargetWithEnv(stdout, stderr, env, target, args);

    if (goos == "linux")
    {
        auto support = prepareLinuxComposerScriptSupport(goos, workingDir, args, env);
        Exception runErr;
        int exitCode = 0;
        try
        {
            exitCode = executeTargetWithEnv(stdout, stderr, env, target, args);
        }
        catch (Exception e)
        {
            runErr = e;
        }
        auto cleanupErr = support.cleanup();
        if (runErr !is null && cleanupErr !is null)
            throw new Exception(runErr.msg ~ "; " ~ cleanupErr.msg);
        if (runErr !is null)
            throw runErr;
        if (cleanupErr !is null)
            throw cleanupErr;
        return exitCode;
    }

    if (goos == "windows")
    {
        auto support = prepareWindowsComposerScriptSupport(goos, workingDir, args, env);
        Exception runErr;
        int exitCode = 0;
        try
        {
            exitCode = executeTargetWithEnv(stdout, stderr, env, target, args);
        }
        catch (Exception e)
        {
            runErr = e;
        }
        auto cleanupErr = support.cleanup();
        if (runErr !is null && cleanupErr !is null)
            throw new Exception(runErr.msg ~ "; " ~ cleanupErr.msg);
        if (runErr !is null)
            throw runErr;
        if (cleanupErr !is null)
            throw cleanupErr;
        return exitCode;
    }

    return executeTargetWithEnv(stdout, stderr, env, target, args);
}

unittest
{
    import std.file : mkdirRecurse;
    import polka.support.fs : createTempDir, rmdirRecurseQuiet;

    // Linux: grants execute bit temporarily to direct extensionless PHP-shebang scripts
    // and restores original permissions afterward.
    version (Posix)
    {
        auto projectDir = createTempDir("polka-linux-cs-");
        scope (exit) rmdirRecurseQuiet(projectDir);

        auto binDir = buildPath(projectDir, "bin");
        mkdirRecurse(binDir);
        auto consolePath = buildPath(binDir, "console");
        write(consolePath, "#!/usr/bin/env php\n<?php echo 'ok';\n");
        setFileMode(consolePath, octal!644);
        write(buildPath(projectDir, "composer.json"), `{
  "scripts": {
    "post-install-cmd": ["@post-cmd"],
    "post-cmd": ["Vendor\\Handler::run", "bin/console cache:clear --no-warmup"]
  }
}`);

        auto support = prepareLinuxComposerScriptSupport("linux", projectDir, null, null);
        assert((getFileMode(consolePath) & octal!111) != 0);
        assert(support.cleanup() is null);
        assert((getFileMode(consolePath) & octal!777) == octal!644);
    }
}

unittest
{
    import polka.support.fs : createTempDir, rmdirRecurseQuiet;

    // Linux: leaves already-executable scripts untouched.
    version (Posix)
    {
        auto projectDir = createTempDir("polka-linux-exec-");
        scope (exit) rmdirRecurseQuiet(projectDir);

        auto consolePath = buildPath(projectDir, "console");
        write(consolePath, "#!/usr/bin/env php\n<?php\n");
        setFileMode(consolePath, octal!755);
        write(buildPath(projectDir, "composer.json"), `{"scripts":{"test":"console test"}}`);

        auto support = prepareLinuxComposerScriptSupport("linux", projectDir, null, null);
        assert(support.restored.length == 0);
        assert(support.cleanup() is null);
        assert((getFileMode(consolePath) & octal!777) == octal!755);
    }
}

unittest
{
    import std.file : mkdirRecurse;
    import polka.support.fs : createTempDir, rmdirRecurseQuiet;

    // Linux: respects --working-dir when scanning composer.json.
    version (Posix)
    {
        auto projectDir = createTempDir("polka-linux-wd-");
        scope (exit) rmdirRecurseQuiet(projectDir);

        auto appDir = buildPath(projectDir, "app");
        mkdirRecurse(appDir);
        auto scriptPath = buildPath(appDir, "artisan");
        write(scriptPath, "#!/usr/bin/php\n<?php\n");
        setFileMode(scriptPath, octal!644);
        write(buildPath(appDir, "composer.json"), `{"scripts":{"post-update-cmd":"artisan migrate"}}`);

        auto support = prepareLinuxComposerScriptSupport("linux", projectDir, ["--working-dir", "app", "update"], null);
        assert((getFileMode(scriptPath) & octal!111) != 0);
        assert(support.cleanup() is null);
        assert((getFileMode(scriptPath) & octal!777) == octal!644);
    }
}

