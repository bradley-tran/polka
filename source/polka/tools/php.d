enum string phpCABundlePath = "extras/ssl/cacert.pem";
enum string phpOpenSSLConfigPath = "extras/ssl/openssl.cnf";

/// Overridable URLs for Windows PHP release index & binary base directory.
package string phpWindowsReleaseURL = "https://windows.php.net/downloads/releases/releases.json";
package string phpWindowsBaseURL = "https://windows.php.net/downloads/releases";

private enum string generatedOpenSSLConfigText =
    "# Generated by Polka. Re-run polka install to recreate this file.\n" ~
    "HOME = .\n\n" ~
    "[req]\n" ~
    "distinguished_name = req_distinguished_name\n\n" ~
    "[req_distinguished_name]\n";

private static immutable string[] systemCABundleCandidates = [
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/ca-bundle.pem",
    "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
    "/etc/ssl/cert.pem",
];

/// Archive path + SHA-256 entry in `releases.json`.
struct PHPWindowsAsset
{
    string path;
    string sha256;
}

/// Compiler/arch variant entry containing runtime `zip` and optional `devel_pack`.
struct PHPWindowsVariant
{
    PHPWindowsAsset zip;
    PHPWindowsAsset develPack;
}

/// One series entry (e.g. `"8.4"`) in Windows PHP `releases.json`.
struct PHPWindowsRelease
{
    string version_;
    PHPWindowsVariant[string] variants;
}

/// Returns the non-thread-safe PHP runtime `ToolPlugin`.
ToolPlugin phpPlugin() @safe
{
    return phpRuntimePlugin(PHP, false);
}

/// Returns the thread-safe PHP ZTS runtime `ToolPlugin`.
ToolPlugin phpZTSPlugin() @safe
{
    return phpRuntimePlugin(PHPZTS, true);
}

private ToolPlugin phpRuntimePlugin(string tool, bool threadSafe) @safe
{
    PluginHooks hooks;
    hooks.validate = (const Environment environment) {
        if (environment.toolVersion(PHP).length > 0 && environment.toolVersion(PHPZTS).length > 0)
            throw new Exception("php and php-zts versions are mutually exclusive");
        auto ver = pluginPHPVersion(tool, environment).strip();
        if (ver.length > 0)
            validateVersion(tool, ver);
        validateOPcachePreset(environment.opcachePreset);
        foreach (name, value; environment.opcacheConfig)
            validateOPcacheDirective(name, value);
        validatePHPMemoryLimit(environment.memoryLimit);

        foreach (pkg, extVer; environment.pieExtensions)
        {
            validatePIEExtensionPackage(pkg);
            validatePIEExtensionVersion(pkg, extVer);
        }
        foreach (pkg, ext; environment.peclExtensions)
        {
            validatePECLExtensionPackage(pkg);
            validatePECLExtensionVersion(pkg, ext.version_);
            foreach (piePkg, _; environment.pieExtensions)
            {
                if (pieExtensionModuleName(piePkg) == pkg.strip().toLower())
                {
                    throw new Exception(format(
                        "PHP module %s is configured through both recommended PIE package %s and legacy PECL",
                        pkg, piePkg
                    ));
                }
            }
        }
    };
    hooks.download = (DownloadContext ctx) {
        downloadPHP(ctx.client, ctx.cacheDir, tool, ctx.version_, threadSafe);
    };
    hooks.postInstall = (InstallContext ctx) {
        syncInstalledPHPRuntimeConfig(ctx.envsDir, ctx.result.tool, ctx.result.version_, ctx.environment);
    };
    hooks.dependencies = (const Environment environment) {
        if (!environment.phpBuildTools())
            return cast(InstallRequest[]) null;
        auto ver = pluginPHPVersion(tool, environment).strip();
        if (ver.length == 0 || currentOS() != "windows")
            return cast(InstallRequest[]) null;
        return [
            InstallRequest(PHPDevel, ver),
            InstallRequest(PHPSDK, DefaultPHPSDKVersion),
        ];
    };
    return newManifestPlugin(tool, hooks);
}

/// Regenerates `php.ini` and OpenSSL/CA-bundle assets when effective config is non-empty.
void syncInstalledPHPRuntimeConfig(string envsDir, string tool, string ver, const Environment environment) @trusted
{
    syncInstalledPHPRuntimeConfigImpl(envsDir, tool, ver, environment, false);
}

/// Rewrites `php.ini` unconditionally so shrinking settings clears old generated directives.
void resyncInstalledPHPRuntimeConfig(string envsDir, string tool, string ver, const Environment environment) @trusted
{
    syncInstalledPHPRuntimeConfigImpl(envsDir, tool, ver, environment, true);
}

private void syncInstalledPHPRuntimeConfigImpl(
    string envsDir,
    string tool,
    string ver,
    const Environment environment,
    bool force
) @trusted
{
    ensureInstalledPHPOpenSSLConfig(envsDir, tool, ver);

    auto phpConfig = effectivePHPConfigForInstall(environment);
    if (phpConfigNeedsCABundle(phpConfig))
        phpConfig.caBundlePath = ensureInstalledPHPCABundle(envsDir, tool, ver);
    if (phpConfig.isZero() && !force)
        return;

    writeInstalledPHPConfigForTool(envsDir, tool, ver, phpConfig);
}

private string pluginPHPVersion(string tool, const Environment environment) @safe pure
{
    if (tool == PHPZTS)
        return environment.toolVersion(PHPZTS);
    return environment.toolVersion(PHP);
}

/// Reports whether enabled `curl` or `openssl` extensions require `curl.cainfo` / `openssl.cafile`.
bool phpConfigNeedsCABundle(const PHPInstallConfig cfg) @safe pure
{
    foreach (name, enabled; cfg.extensions)
    {
        if (!enabled)
            continue;
        switch (normalizePHPModuleName(name))
        {
            case "curl":
            case "openssl":
                return true;
            default:
                break;
        }
    }
    return false;
}

/// Ensures a CA certificate bundle path exists for generated PHP TLS settings.
string ensureInstalledPHPCABundle(string envsDir, string tool, string ver) @trusted
{
    auto caBundlePath = installedPHPCABundlePath(envsDir, tool, ver);
    if (exists(caBundlePath) && !isDir(caBundlePath))
        return caBundlePath;

    if (currentOS() == "windows")
    {
        writeWindowsSystemCABundle(caBundlePath);
        return caBundlePath;
    }

    return findSystemCABundle();
}

string installedPHPCABundlePath(string envsDir, string tool, string ver) @safe
{
    return buildPath(envsDir, tool, ver, fromSlashPath(phpCABundlePath));
}

string ensureInstalledPHPOpenSSLConfig(string envsDir, string tool, string ver) @trusted
{
    return ensureInstalledPHPOpenSSLConfigAt(buildPath(envsDir, tool, ver));
}

string ensureInstalledPHPOpenSSLConfigAt(string installDir) @trusted
{
    auto configPath = buildPath(installDir, fromSlashPath(phpOpenSSLConfigPath));
    if (exists(configPath) && !isDir(configPath))
        return configPath;

    mkdirRecurse(dirName(configPath));
    write(configPath, generatedOpenSSLConfigText);
    setFileMode(configPath, octal!644);
    return configPath;
}

string installedPHPOpenSSLConfigPath(string envsDir, string tool, string ver) @safe
{
    return buildPath(envsDir, tool, ver, fromSlashPath(phpOpenSSLConfigPath));
}

string findSystemCABundle() @trusted
{
    foreach (p; systemCABundleCandidates)
    {
        if (exists(p) && !isDir(p))
            return p;
    }
    throw new Exception("no system ca bundle found for generated PHP OpenSSL/cURL config");
}

private void writeWindowsSystemCABundle(string targetPath) @trusted
{
    auto data = exportWindowsSystemCABundle();
    mkdirRecurse(dirName(targetPath));
    write(targetPath, data);
    setFileMode(targetPath, octal!644);
}

private string exportWindowsSystemCABundle() @trusted
{
    auto script = [
        "$ErrorActionPreference = 'Stop'",
        "$seen = New-Object 'System.Collections.Generic.HashSet[string]'",
        "foreach ($location in @('CurrentUser', 'LocalMachine')) {",
        "  $store = New-Object System.Security.Cryptography.X509Certificates.X509Store('Root', $location)",
        "  $store.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadOnly)",
        "  try {",
        "    foreach ($cert in $store.Certificates) {",
        "      if ([string]::IsNullOrWhiteSpace($cert.Thumbprint) -or -not $seen.Add($cert.Thumbprint)) { continue }",
        "      '-----BEGIN CERTIFICATE-----'",
        "      [Convert]::ToBase64String($cert.RawData, [Base64FormattingOptions]::InsertLineBreaks)",
        "      '-----END CERTIFICATE-----'",
        "      ''",
        "    }",
        "  } finally {",
        "    $store.Close()",
        "  }",
        "}",
    ].join("\n");

    auto res = execute([
        "powershell.exe",
        "-NoLogo", "-NoProfile", "-NonInteractive",
        "-ExecutionPolicy", "Bypass",
        "-EncodedCommand", powershellEncodedCommand(script),
    ]);
    if (res.status != 0)
    {
        auto detail = res.output.strip();
        if (detail.length > 0)
            throw new Exception(format("export windows root certificates: exit status %d: %s", res.status, detail));
        throw new Exception(format("export windows root certificates: exit status %d", res.status));
    }
    if (!res.output.canFind("-----BEGIN CERTIFICATE-----"))
        throw new Exception("export windows root certificates: no certificates were exported");
    return res.output;
}

private string powershellEncodedCommand(string script) @safe
{
    import std.utf : toUTF16;
    auto utf16Units = toUTF16(script);
    ubyte[] bytes = new ubyte[utf16Units.length * 2];
    foreach (i, wchar u; utf16Units)
    {
        bytes[i * 2] = cast(ubyte)(u & 0xFF);
        bytes[i * 2 + 1] = cast(ubyte)((u >> 8) & 0xFF);
    }
    return Base64.encode(bytes);
}

void validateOPcachePreset(string preset) @safe pure
{
    auto norm = normalizeOPcachePreset(preset);
    if (norm.length == 0 || norm == OPcachePresetDev || norm == OPcachePresetProduction)
        return;
    throw new Exception(format(`unsupported opcache-preset "%s": use none, dev, or production`, preset));
}

void downloadPHP(HTTPClient client, string cacheDir, string tool, string ver, bool threadSafe) @trusted
{
    if (currentOS() != "windows")
        throw new Exception("automatic php download is only implemented on Windows");

    mkdirRecurse(buildPath(cacheDir, tool));
    auto index = fetchPHPWindowsReleaseIndex(client);
    auto series = phpSeries(ver);
    auto relPtr = series in index;
    if (relPtr is null)
        throw new Exception(format(`php version "%s" is not available in the Windows release index`, ver));

    auto variant = selectPHPWindowsVariant(*relPtr, threadSafe);
    auto asset = variant.zip;

    auto stagingDir = createTempDir(ver ~ "-tmp-", buildPath(cacheDir, tool));
    scope (exit) rmdirRecurseQuiet(stagingDir);

    auto fileName = baseName(asset.path);
    auto archivePath = buildPath(stagingDir, fileName);
    auto archiveURL = format("%s/%s", phpWindowsBaseURL, asset.path);
    downloadFile(client, archiveURL, archivePath);
    verifyChecksum(asset.sha256, archivePath);

    DownloadAsset dlAsset;
    dlAsset.fileName = fileName;
    dlAsset.url = archiveURL;
    dlAsset.checksum = asset.sha256;
    dlAsset.checksumAlgorithm = ChecksumAlgorithm.sha256;
    dlAsset.archiveFormat = ArchiveFormat.zip;
    cacheArchivePayload(cacheDir, tool, ver, relPtr.version_, dlAsset, archivePath);
}

/// Fetches and decodes `releases.json` from `windows.php.net`.
PHPWindowsRelease[string] fetchPHPWindowsReleaseIndex(HTTPClient client) @trusted
{
    auto text = downloadText(client, phpWindowsReleaseURL, "php release index");
    return parsePHPWindowsReleaseIndex(text);
}

/// Decodes Windows PHP `releases.json` into series -> variants maps.
PHPWindowsRelease[string] parsePHPWindowsReleaseIndex(string jsonText) @trusted
{
    JSONValue root;
    try
    {
        root = parseJSON(jsonText);
    }
    catch (Exception e)
    {
        throw new Exception("decode php release index: " ~ e.msg);
    }
    if (root.type != JSONType.object)
        throw new Exception("decode php release index: expected JSON object");

    PHPWindowsRelease[string] index;
    foreach (series, relNode; root.object)
    {
        if (relNode.type != JSONType.object)
            continue;
        PHPWindowsRelease rel;
        rel.version_ = jsonStringField(relNode, "version");
        foreach (k, vNode; relNode.object)
        {
            if (k == "version" || k == "source" || k == "test_pack")
                continue;
            if (vNode.type != JSONType.object)
                continue;
            PHPWindowsVariant variant;
            if (auto zp = "zip" in vNode.object)
            {
                variant.zip = PHPWindowsAsset(
                    jsonStringField(*zp, "path"),
                    jsonStringField(*zp, "sha256")
                );
            }
            if (auto dp = "devel_pack" in vNode.object)
            {
                variant.develPack = PHPWindowsAsset(
                    jsonStringField(*dp, "path"),
                    jsonStringField(*dp, "sha256")
                );
            }
            if (variant.zip.path.length > 0)
                rel.variants[k] = variant;
        }
        index[series] = rel;
    }
    return index;
}

PHPWindowsAsset selectPHPWindowsAsset(const PHPWindowsRelease release, bool threadSafe) @safe
{
    return selectPHPWindowsVariant(release, threadSafe).zip;
}

/// Selects the matching NTS/ZTS compiler variant for the host architecture without crossing flavors.
PHPWindowsVariant selectPHPWindowsVariant(const PHPWindowsRelease release, bool threadSafe) @safe
{
    auto architecture = currentArch() == "386" ? "x86" : "x64";
    auto flavor = threadSafe ? "ts" : "nts";
    auto preferences = [
        flavor ~ "-vs17-" ~ architecture,
        flavor ~ "-vs16-" ~ architecture,
        flavor ~ "-vc15-" ~ architecture,
    ];

    foreach (key; preferences)
    {
        if (auto p = key in release.variants)
        {
            if (p.zip.path.length > 0)
                return *p;
        }
    }
    throw new Exception(format("no compatible Windows PHP %s binary found for %s on %s",
        flavor.toUpper(), release.version_, architecture));
}

string phpSeries(string ver) @safe pure
{
    return versionMajorMinor(ver);
}

unittest
{
    import std.file : readText;
    import polka.support.yaml : YamlValue;

    // TestSelectPHPWindowsAssetUsesStrictFlavor & DoesNotCrossFlavor
    {
        PHPWindowsRelease rel;
        rel.version_ = "8.4.8";
        rel.variants["nts-vs17-x64"] = PHPWindowsVariant(PHPWindowsAsset("php-nts.zip", ""), PHPWindowsAsset.init);
        rel.variants["ts-vs17-x64"] = PHPWindowsVariant(PHPWindowsAsset("php-ts.zip", ""), PHPWindowsAsset.init);

        assert(selectPHPWindowsAsset(rel, false).path == "php-nts.zip");
        assert(selectPHPWindowsAsset(rel, true).path == "php-ts.zip");

        PHPWindowsRelease tsOnly;
        tsOnly.version_ = "8.4.8";
        tsOnly.variants["ts-vs17-x64"] = PHPWindowsVariant(PHPWindowsAsset("php-ts.zip", ""), PHPWindowsAsset.init);
        bool threw = false;
        try { selectPHPWindowsAsset(tsOnly, false); }
        catch (Exception e) { threw = e.msg.canFind("NTS"); }
        assert(threw);
    }

    // TestPHPWindowsReleaseIndexDecodesDevelPack
    {
        auto index = parsePHPWindowsReleaseIndex(`{
            "8.4": {
                "version": "8.4.24",
                "nts-vs17-x64": {
                    "zip": {"path": "php-8.4.24-nts.zip", "sha256": "runtime"},
                    "devel_pack": {"path": "php-devel-pack-8.4.24-nts.zip", "sha256": "devel"}
                }
            }
        }`);
        auto variant = selectPHPWindowsVariant(index["8.4"], false);
        assert(variant.zip.path == "php-8.4.24-nts.zip");
        assert(variant.develPack.path == "php-devel-pack-8.4.24-nts.zip");
        assert(variant.develPack.sha256 == "devel");
    }

    // TestSelectPHPWindowsVariantPairsZTSDevelPack
    {
        PHPWindowsRelease rel;
        rel.version_ = "8.4.24";
        rel.variants["nts-vs17-x64"] = PHPWindowsVariant(PHPWindowsAsset("php-nts.zip", ""), PHPWindowsAsset("php-devel-nts.zip", ""));
        rel.variants["ts-vs17-x64"] = PHPWindowsVariant(PHPWindowsAsset("php-ts.zip", ""), PHPWindowsAsset("php-devel-ts.zip", ""));
        auto variant = selectPHPWindowsVariant(rel, true);
        assert(variant.zip.path == "php-ts.zip");
        assert(variant.develPack.path == "php-devel-ts.zip");
    }

    // TestPHPBuildToolDependencies
    {
        Environment flagOff;
        flagOff.tools = [PHP: "8.4"];
        assert((cast(ToolDependencyProvider) phpPlugin()).dependencies(flagOff).length == 0);

        Environment ntsEnv;
        ntsEnv.tools = [PHP: "8.4"];
        ntsEnv.settings = [PHP: ["extension-sdk": YamlValue.fromBool(true)]];
        auto deps = (cast(ToolDependencyProvider) phpPlugin()).dependencies(ntsEnv);
        if (currentOS() != "windows")
            assert(deps.length == 0);
        else
            assert(deps == [InstallRequest(PHPDevel, "8.4"), InstallRequest(PHPSDK, DefaultPHPSDKVersion)]);
    }

    // TestPHPConfigNeedsCABundleForTLSClientExtensions
    {
        foreach (ext; ["curl", "OpenSSL"])
        {
            PHPInstallConfig c;
            c.extensions = [ext: true];
            assert(phpConfigNeedsCABundle(c));
        }
        PHPInstallConfig c2;
        c2.extensions = ["openssl": false, "zip": true];
        assert(!phpConfigNeedsCABundle(c2));
    }

    // TestEnsureInstalledPHPOpenSSLConfigWritesFallback & PreservesExisting
    {
        auto envsDir = createTempDir("polka-openssl-");
        scope (exit) rmdirRecurseQuiet(envsDir);

        auto p = ensureInstalledPHPOpenSSLConfig(envsDir, PHP, "8.4");
        assert(p == buildPath(envsDir, PHP, "8.4", fromSlashPath(phpOpenSSLConfigPath)));
        auto content = readText(p);
        foreach (want; ["HOME = .", "[req]", "distinguished_name = req_distinguished_name", "[req_distinguished_name]"])
            assert(content.canFind(want), want);

        write(p, "custom-openssl-config\n");
        auto got = ensureInstalledPHPOpenSSLConfig(envsDir, PHP, "8.4");
        assert(got == p);
        assert(readText(p) == "custom-openssl-config\n");
    }
}
